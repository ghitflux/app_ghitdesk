{
  "name": "ghitdesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "storybook": "pnpm --filter web storybook"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "turbo": "^1.10.0"
  },
  "pnpm": {
    "overrides": {
      "react": "18.2.0",
      "react-dom": "18.2.0"
    },
    "auditConfig": {
      "ignoreCves": [
        "node_modules",
        ".next",
        "dist",
        "__pycache__"
      ]
    }
  }
}
