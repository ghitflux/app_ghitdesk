{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "GhitDesk Fastify API with Better Auth",
  "main": "./dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --dts",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ghit/core": "workspace:*",
    "fastify": "^4.26.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^2.1.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "better-auth": "^1.3.28",
    "drizzle-orm": "^0.36.4",
    "drizzle-kit": "^0.29.1",
    "pg": "^8.13.1",
    "socket.io": "^4.6.1",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.4",
    "dotenv": "^16.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.7.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0"
  }
}
